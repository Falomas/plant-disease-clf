# Шаблон окружения. Скопируйте в .env и при необходимости поправьте пути.
# Секретов здесь нет. Файл .env в git не попадает.
# Код проекта эти переменные пока не читает.

# Каталог данных. Сама папка data/ в репозиторий не входит.
DATA_DIR=data

# Путь к артефакту модели относительно корня проекта.
MODEL_ARTIFACT_PATH=artifacts/model.onnx

# Локальный MLflow без токена и удалённого сервера.
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
