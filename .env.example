# Шаблон окружения. Скопируйте в .env и при необходимости поправьте пути.
# Секретов здесь нет. Файл .env в git не попадает.
# Значения относительные: не привязаны к диску автора.

# Каталог снимков. Обязателен для train-конфига. Сама папка data/ в git не входит.
DATA_DIR=data

# Файл модели. Обязателен для inference-конфига. Сами веса в git не входят.
MODEL_ARTIFACT_PATH=artifacts/best_model.pt

# Локальный MLflow без токена и удалённого сервера.
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Адрес уже запущенного API. Интерфейс ходит только туда.
API_URL=http://127.0.0.1:8000
