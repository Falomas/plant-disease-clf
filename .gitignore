*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
mlruns/
.dvc/cache/
.dvc/tmp/
.dvc/config.local

# Сборки
build/
dist/
*.egg-info/
.eggs/

# Локальный мусор редактора и ОС
.idea/
.vscode/
*.log
.DS_Store
Thumbs.db
