# Виртуальное окружение и секреты
.venv/
venv/
.env
.env.local

# Изображения не коммитим. Файл data/*.dvc — указатель DVC, его оставляем.
/data/*
!/data/*.dvc
*.pt
*.pth
*.onnx
*.ckpt

# Кэши Python и экспериментов
